.DS_Store
__pycache__/
*.pyc
.cache/
.typst-*/
# fixtures build in place; the outputs are regenerable and must not be tracked
tests/**/*.html
tests/**/*.pdf
# a .docx is a zip: its bytes differ run to run even from identical sources
tests/**/*.docx
dist/
tests/**/published/
.coverage
.coverage.*
coverage-report.json
# run records churn on every build; a claims lock does not - it is what an
# author accepted a gist against, and a lock only one machine has vouches
# for nothing anywhere else
tests/**/.paperforge/runs/
